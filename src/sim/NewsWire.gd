class_name NewsWire
extends RefCounted
## Phase 266/267: 动态新闻. The city reports on itself, and only about things that happened.
##
## Every line is generated by comparing this hour's measured state against last hour's, and
## every item carries the numbers that produced it in `facts`. That rule is what separates a
## news system from a decoration: a headline that cannot name the quantity behind it is not
## written, and the self-test asserts that each item's district exists in the ledger and that
## the figures it quotes are the ones still in state.
##
## Phase 267 asks for "AI 生成". What is implemented is deterministic state-to-language: rules
## over real variables, seeded, reproducible, offline, legible. An LLM-written news desk would
## be a network call to somebody else's model, and Part 10 forbids passing server-side invention
## off as a world fact - so the generator stays local, and the model-backed variant is recorded
## as 待实现 rather than half-faked here.

const MAX_ITEMS := 60
## Minimum relative change worth a headline, per topic. Below these the city is simply Tuesday.
const PRICE_MOVE := 0.012
const EMP_MOVE := 0.02
const POP_MOVE := 0.0005
const CONGEST := 0.75

var items: Array = []
var published := 0
## How many headlines each desk has written over the whole session. `items` is a 60-slot ring, so
## asking it "which parts of the city got reported" answers only about the most recent burst - a
## churn wave would make the wire look one-note after a run in which it covered everything.
var sources := {}
var _prev: Dictionary = {}
var _seen_seq := 0
## Residents at the last reported day boundary. Population is a daily quantity: compared hour
## against hour it barely moves, so a daily figure has to be held back until the next day closes.
var _day_residents := 0
var _last_life_day := -1


## One hour of editorial judgement. Returns how many headlines were written.
func evaluate(sim: CitySim, vpop: VirtualPopulation, consumer: ConsumerAI,
		trips: TripDemand, rain: float) -> int:
	var now := _measure(sim, vpop, trips, rain)
	var wrote := 0
	if not _prev.is_empty():
		wrote += _economy(sim, now)
		wrote += _labour(now)
		wrote += _commerce(sim)
		wrote += _streets(trips, now)
		wrote += _people(vpop, now)
		wrote += _weather(sim, now)
	_prev = now
	_seen_seq = sim.event_seq
	published += wrote
	return wrote


## The measured snapshot every comparison is made against. Nothing in here is a constant.
func _measure(sim: CitySim, vpop: VirtualPopulation, trips: TripDemand,
		rain: float) -> Dictionary:
	var price := {}
	var labor := 0
	var top := "全市"
	var topv := -1
	for dn in sim.districts.keys():
		var d: Dictionary = sim.districts[dn]
		labor += int(d["labor"])
		if int(d["employed"]) > topv:
			topv = int(d["employed"])
			top = String(dn)
		for c in CitySim.CATS:
			if not price.has(c):
				price[c] = [0.0, 0]
			var pc: Array = price[c]
			pc[0] = float(pc[0]) + float(int(d["shops"][c]["price_c"]))
			pc[1] = int(pc[1]) + 1
	for c in price.keys():
		var pc2: Array = price[c]
		price[c] = float(pc2[0]) / maxf(float(pc2[1]), 1.0)
	var residents := vpop.residents_total()
	var emp := sim.total_employment()
	return {"price": price, "employed": emp, "labor": maxi(1, labor), "top": top,
		"rate": float(emp) / maxf(float(labor), 1.0), "rain": rain, "hours": sim.hours_run,
		"congestion": trips.peak_congestion(), "residents": residents,
		"migrated": vpop.migrated_total, "shops": sim.total_shops()}


func _emit(src: String, head: String, facts: Dictionary) -> void:
	var f := facts.duplicate()
	f["hour"] = int(_prev.get("hours", 0))
	items.append({"head": head, "src": src, "facts": f})
	sources[src] = int(sources.get(src, 0)) + 1
	if items.size() > MAX_ITEMS:
		items.pop_front()


## Which desks have filed at all, over the whole session rather than the last 60 lines.
func source_mix() -> Dictionary:
	return sources.duplicate()


## Prices: one line per category whose district mean crossed the threshold, naming the district
## where the counter is dearest (or cheapest) rather than inventing a region.
func _economy(sim: CitySim, now: Dictionary) -> int:
	var wrote := 0
	for c in CitySim.CATS:
		var p0 := float((_prev["price"] as Dictionary).get(c, 0.0))
		var p1 := float((now["price"] as Dictionary).get(c, 0.0))
		if p0 <= 0.0 or p1 <= 0.0:
			continue
		var rel := (p1 - p0) / p0
		if absf(rel) < PRICE_MOVE:
			continue
		var dn := _price_extreme(sim, String(c), rel > 0.0)
		_emit("economy", "%s%s均价%s至 %.0f 分，%s%s" % [dn, _cat(String(c)),
			"上涨" if rel > 0.0 else "下跌", p1, _cat(String(c)),
			"排队变长" if rel > 0.0 else "客流回落"],
			{"district": dn, "cat": String(c), "from_c": int(round(p0)),
				"to_c": int(round(p1)), "pct": rel})
		wrote += 1
	return wrote


## Employment: the wage bill moved, so the jobs line reports the district carrying most of it.
func _labour(now: Dictionary) -> int:
	var e0 := int(_prev.get("employed", 0))
	var e1 := int(now["employed"])
	if e0 <= 0 or absf(float(e1 - e0) / float(e0)) < EMP_MOVE:
		return 0
	var dn := String(_prev.get("top", "全市"))
	var rate := 100.0 * (1.0 - float(e1) / maxf(float(int(now["labor"])), 1.0))
	_emit("labour", "%s商圈%s：%d 人，全市就业 %d→%d，失业率 %.1f%%" % [dn,
		"增员" if e1 > e0 else "缩编", absi(e1 - e0), e0, e1, rate],
		{"district": dn, "from": e0, "to": e1, "unemployment": rate})
	return 1


## Commerce: churn is already recorded as events by CitySim, so the wire reports those records
## instead of re-deriving a number that could disagree with the ledger.
##
## It counts them off `event_seq`, not `events.size()`. The record list is a 200-item ring, so once
## the city has traded for long enough the size never changes again and a shop closing becomes
## permanently invisible to anything comparing lengths - which is exactly what this used to do.
func _commerce(sim: CitySim) -> int:
	var fresh := sim.event_seq - _seen_seq
	if fresh <= 0:
		return 0
	fresh = mini(fresh, sim.events.size())
	var wrote := 0
	for i in range(sim.events.size() - fresh, sim.events.size()):
		var e: Dictionary = sim.events[i]
		var kind := String(e["kind"])
		if kind == "OPEN" or kind == "CLOSE":
			_emit("commerce", "%s%s一家%s，该类别在营 %d 家" % [String(e["district"]),
				"新开" if kind == "OPEN" else "关掉", _cat(String(e["cat"])), int(e["count"])],
				{"district": String(e["district"]), "cat": String(e["cat"]),
					"count": int(e["count"]), "kind": kind})
			wrote += 1
		elif kind.begins_with("PLAYER_"):
			_emit("player", "玩家在%s%s，街区账本已计入" % [String(e["district"]),
				"开店" if kind.ends_with("OPEN") else "关店"],
				{"district": String(e["district"]), "kind": kind, "count": int(e["count"])})
			wrote += 1
	return wrote


## Streets: congestion is measured from trips the crowd and traffic published, so this line can
## only exist if people actually generated the demand.
func _streets(trips: TripDemand, now: Dictionary) -> int:
	var c := float(now["congestion"])
	if c < CONGEST:
		return 0
	var b := trips.busiest()
	if b.is_empty():
		return 0
	var at: Vector2 = b["at"]
	var dn := String(CityData.district_at(at)["name"])
	## The load is stated as bodies occupying the corner, because that is what the field now holds:
	## pedestrians plus cars weighted by the road space each takes. Calling it "trips" would be a
	## unit the number does not have.
	_emit("traffic", "%s路口拥堵指数 %.2f，%.0f 个交通主体正在占用，车速降至 %.0f%%" % [dn, c,
		float(b["load"]), 100.0 * trips.slow_at(at)],
		{"district": dn, "congestion": c, "load": float(b["load"]), "x": at.x, "z": at.y})
	return 1


## People: the cohort layer's own output, compared day against day rather than hour against hour.
## An hour of migration is a rounding error; a day of it is a headline, and this is the only way to
## report it without lowering the threshold until every hour is news.
func _people(vpop: VirtualPopulation, now: Dictionary) -> int:
	var d := int(vpop.days_run)
	var r1 := int(now["residents"])
	if _last_life_day < 0:
		_last_life_day = d
		_day_residents = r1
		return 0
	if d <= _last_life_day:
		return 0
	var r0 := _day_residents
	_day_residents = r1
	_last_life_day = d
	if r0 <= 0:
		return 0
	var rel := float(r1 - r0) / float(r0)
	if absf(rel) < POP_MOVE:
		return 0
	_emit("life", "全市虚拟人口%s至 %s（%+.2f%%），累计净迁移 %d 人" % [
		"增加" if rel > 0.0 else "减少", _wan(r1), rel * 100.0, int(now["migrated"])],
		{"from": r0, "to": r1, "migrated": int(now["migrated"]),
			"district": String(_prev.get("top", "全市"))})
	return 1


## Rain is only a headline when it changes what the city buys, which the simulation can say.
func _weather(sim: CitySim, now: Dictionary) -> int:
	var r0 := float(_prev.get("rain", 0.0))
	var r1 := float(now["rain"])
	if r1 < 0.5 or r0 < 0.5:
		return 0
	var ride := 0.0
	for dn in sim.districts.keys():
		ride += float(sim.districts[dn]["ride_demand"])
	ride /= maxf(float(sim.districts.size()), 1.0)
	_emit("weather", "全市持续降雨，出行需求升至 %.2f，公交与出租成为主要选择" % ride,
		{"rain": r1, "ride_demand": ride})
	return 1


func _price_extreme(sim: CitySim, cat: String, up: bool) -> String:
	var best := "全市"
	var bv := -1e18
	for dn in sim.districts.keys():
		var p := float(int(sim.districts[dn]["shops"][cat]["price_c"]))
		var v := p if up else -p
		if v > bv:
			bv = v
			best = String(dn)
	return best


func _cat(c: String) -> String:
	return {"food": "餐饮", "retail": "零售", "leisure": "休闲", "transit": "出行"}.get(c, c)


static func _wan(v: int) -> String:
	return "%.1f万" % (float(v) / 10000.0) if v > 10000 else str(v)


## The district holding the most jobs, remembered between hours so labour and population lines
## can name a place instead of an average.
func latest() -> String:
	return String(items[items.size() - 1]["head"]) if not items.is_empty() else ""


func since(n: int) -> Array:
	return items.slice(maxi(0, items.size() - n))


func stats() -> Dictionary:
	return {"items": items.size(), "published": published}
