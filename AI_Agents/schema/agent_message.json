{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SOW agent hand-off message",
  "type": "object",
  "required": ["agent", "task", "status", "result", "evidence"],
  "properties": {
    "agent": { "type": "string" },
    "task": { "type": "string", "minLength": 4 },
    "status": { "enum": ["working", "blocked", "done"] },
    "result": { "enum": ["success", "failure", "partial", "pending"] },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "evidence": {
      "type": "object",
      "required": ["files"],
      "properties": {
        "commands": { "type": "array", "items": { "type": "string" } },
        "assertions": { "type": "string", "pattern": "^[0-9]+/[0-9]+ (PASS|FAIL)$" },
        "files": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "metrics": { "type": "object" }
      }
    }
  }
}
